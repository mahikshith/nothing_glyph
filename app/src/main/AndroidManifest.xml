<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Glyph SDK access (a normal permission on Nothing phones). -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <!-- Only asked for when a rule needs to know who is a contact. Call screening also needs it before Android
         passes calls from saved contacts to DotForge. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Get more on the Ringtones page, and the weekly call spam list download (both from GitHub). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Music visualiser (Live switch, Quick Settings tile, DF Music toy): asked when first switched on. Visualizer
         on the output mix needs it, and so does the microphone fallback. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Visualizer on the output mix (session 0). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Quiet copies of notifications a rule silenced or marked as spam: asked when such a rule is saved. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ringtones > Set as > A contact: asked only then, to set that contact's ringtone. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Ringtones > Set as > Phone ringtone: special access ("Modify system settings"), asked only then. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Toys page > Get toys: installs a toy APK from GitHub; Android's "Install unknown apps" switch is asked
         for then, with Not now, and Android confirms each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <!-- Toys page: every installed Glyph Toy (services answering Nothing's toy action). -->
        <intent>
            <action android:name="com.nothing.glyph.TOY" />
        </intent>
        <!-- The rule editor's app picker lists launcher apps; no QUERY_ALL_PACKAGES needed. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Nothing's Glyph notification settings live in the Settings app (the "Sound only" helper). -->
        <package android:name="com.android.settings" />
    </queries>

    <application
        android:name=".DotForgeApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DotForge">

        <!-- Development key accepted by the Glyph service for unpublished apps. -->
        <meta-data
            android:name="NothingKey"
            android:value="test" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" an .ogg or audio file: lands in Ringtones > Import. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
            <!-- Share an .ogg or audio file to DotForge. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
        </activity>

        <!-- Notification glyphs, filters and progress rings: needs the user to grant Notification access. -->
        <service
            android:name=".notify.GlyphNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Call rules: Android binds it once the user makes DotForge the call screening app (asked when needed). -->
        <service
            android:name=".calls.GlyphCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- PackageInstaller results for toy installs; only our own PendingIntent reaches it. -->
        <receiver
            android:name=".toys.InstallResultReceiver"
            android:exported="false" />

        <!-- Quick Settings tile: glyph torch. -->
        <service
            android:name=".tile.TorchTileService"
            android:exported="true"
            android:icon="@drawable/ic_toy"
            android:label="@string/torch_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Live music visualiser: runs while switched on, drives the matrix only while music plays. -->
        <service
            android:name=".visualiser.LiveVisualiserService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Quick Settings tile: Live music visualiser. -->
        <service
            android:name=".visualiser.LiveTileService"
            android:exported="true"
            android:icon="@drawable/toy_music"
            android:label="@string/live_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Glyph Toys: added in Settings > Glyph Interface > Glyph Toys. -->
        <service
            android:name=".toys.ClockToy"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data android:name="com.nothing.glyph.toy.name" android:resource="@string/toy_clock_name" />
            <meta-data android:name="com.nothing.glyph.toy.image" android:resource="@drawable/toy_clock" />
            <meta-data android:name="com.nothing.glyph.toy.summary" android:resource="@string/toy_clock_summary" />
            <meta-data android:name="com.nothing.glyph.toy.introduction" android:value="com.dotforge.ui.MainActivity" />
            <meta-data android:name="com.nothing.glyph.toy.longpress" android:value="1" />
            <meta-data android:name="com.nothing.glyph.toy.aod_support" android:value="1" />
        </service>

        <service
            android:name=".toys.BatteryToy"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data android:name="com.nothing.glyph.toy.name" android:resource="@string/toy_battery_name" />
            <meta-data android:name="com.nothing.glyph.toy.image" android:resource="@drawable/toy_battery" />
            <meta-data android:name="com.nothing.glyph.toy.summary" android:resource="@string/toy_battery_summary" />
            <meta-data android:name="com.nothing.glyph.toy.introduction" android:value="com.dotforge.ui.MainActivity" />
            <meta-data android:name="com.nothing.glyph.toy.longpress" android:value="1" />
            <meta-data android:name="com.nothing.glyph.toy.aod_support" android:value="1" />
        </service>

        <service
            android:name=".toys.DiceToy"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data android:name="com.nothing.glyph.toy.name" android:resource="@string/toy_dice_name" />
            <meta-data android:name="com.nothing.glyph.toy.image" android:resource="@drawable/toy_dice" />
            <meta-data android:name="com.nothing.glyph.toy.summary" android:resource="@string/toy_dice_summary" />
            <meta-data android:name="com.nothing.glyph.toy.longpress" android:value="1" />
        </service>

        <service
            android:name=".toys.PlayerToy"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data android:name="com.nothing.glyph.toy.name" android:resource="@string/toy_player_name" />
            <meta-data android:name="com.nothing.glyph.toy.image" android:resource="@drawable/toy_player" />
            <meta-data android:name="com.nothing.glyph.toy.summary" android:resource="@string/toy_player_summary" />
            <meta-data android:name="com.nothing.glyph.toy.introduction" android:value="com.dotforge.ui.MainActivity" />
            <meta-data android:name="com.nothing.glyph.toy.longpress" android:value="1" />
            <meta-data android:name="com.nothing.glyph.toy.aod_support" android:value="1" />
        </service>
        <service
            android:name=".toys.MusicToy"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data android:name="com.nothing.glyph.toy.name" android:resource="@string/toy_music_name" />
            <meta-data android:name="com.nothing.glyph.toy.image" android:resource="@drawable/toy_music" />
            <meta-data android:name="com.nothing.glyph.toy.summary" android:resource="@string/toy_music_summary" />
            <meta-data android:name="com.nothing.glyph.toy.introduction" android:value="com.dotforge.ui.MainActivity" />
            <meta-data android:name="com.nothing.glyph.toy.longpress" android:value="1" />
        </service>
    </application>
</manifest>
