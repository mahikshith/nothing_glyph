<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Glyph SDK access (a normal permission on Nothing phones). -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <!-- Only asked for when a rule needs to know who is a contact. Call screening also needs it before Android
         passes calls from saved contacts to DotForge. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Get more on the Ringtones page, and the weekly call spam list download (both from GitHub). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Music visualiser (Live switch, Quick Settings tile, DF Music toy): asked when first switched on. Visualizer
         on the output mix needs it, and so does the microphone fallback. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Visualizer on the output mix (session 0). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Quiet copies of notifications a rule silenced or marked as spam: asked when such a rule is saved. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ringtones > Set as > A contact: asked only then, to set that contact's ringtone. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Ringtones > Set as > Phone ringtone: special access ("Modify system settings"), asked only then. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Toys page > Get toys: installs a toy APK from GitHub; Android's "Install unknown apps" switch is asked
         for then, with Not now, and Android confirms each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- "Keep DotForge running": asks Android to leave the app out of battery optimisation. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Timer & stopwatch: a foreground service keeps a running timer on the Glyph; an exact alarm wakes the
         phone when it ends; a wake lock keeps the burst going until it is dismissed; the Live Update is a
         promoted ongoing notification (Android 16). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- USE_EXACT_ALARM normally covers timers. Should a store build or the phone take exact alarms away, the
         Timer page shows "Timers may end late · Allow", which opens this special access's settings page. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- A timer must never end unseen: "Time's up" opens full screen over the lock screen, and it can buzz. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Live progress > Next calendar event: asked when that ring is switched on; read on the phone only. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- DF Weather: where the phone roughly is, once an hour at most; asked on the toy's page, never needed with a
         typed place. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- DF Day dots: today's screen time ("Usage access", special access asked on the toy's page). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Automation API: apps that hold this (normal) permission may send commands; DotForge obeys only the ones
         the user allows on the Integrations page. -->
    <permission
        android:name="com.dotforge.permission.AUTOMATE"
        android:description="@string/automate_permission_description"
        android:label="@string/automate_permission_label"
        android:protectionLevel="normal" />

    <queries>
        <!-- Toys page: every installed Glyph Toy (services answering Nothing's toy action). -->
        <intent>
            <action android:name="com.nothing.glyph.TOY" />
        </intent>
        <!-- The rule editor's app picker lists launcher apps; no QUERY_ALL_PACKAGES needed. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Nothing's Glyph notification settings live in the Settings app (the "Sound only" helper). -->
        <package android:name="com.android.settings" />
        <!-- Home's always-on line: Nothing's always-on toy chooser and the provider that names the active one. -->
        <package android:name="com.nothing.thirdparty" />
        <provider android:authorities="com.nothing.glyphtoyprovider" />
        <!-- Live progress: the known delivery and ride apps (Installed / Not on this phone, and opening them). -->
        <package android:name="com.application.zomato" />
        <package android:name="in.swiggy.android" />
        <package android:name="com.grofers.customerapp" />
        <package android:name="com.zeptoconsumerapp" />
        <package android:name="com.bigbasket.mobileapp" />
        <package android:name="in.amazon.mShop.android.shopping" />
        <package android:name="com.amazon.mShop.android.shopping" />
        <package android:name="com.flipkart.android" />
        <package android:name="com.ubercab" />
        <package android:name="com.ubercab.uberlite" />
        <package android:name="com.olacabs.customer" />
        <package android:name="com.rapido.passenger" />
    </queries>

    <application
        android:name=".DotForgeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DotForge">

        <!-- Development key accepted by the Glyph service for unpublished apps. -->
        <meta-data
            android:name="NothingKey"
            android:value="test" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" an .ogg or audio file: lands in Ringtones > Import. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
            <!-- Share an .ogg or audio file to DotForge. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
            <!-- Open with or Share a picture, GIF, video or design file: lands in Studio's photo or editor flow. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Shared designs and camera photos, handed out by content URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Notification glyphs, filters and progress rings: needs the user to grant Notification access. -->
        <service
            android:name=".notify.GlyphNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Call rules: Android binds it once the user makes DotForge the call screening app (asked when needed). -->
        <service
            android:name=".calls.GlyphCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- PackageInstaller results for toy installs; only our own PendingIntent reaches it. -->
        <receiver
            android:name=".toys.InstallResultReceiver"
            android:exported="false" />

        <!-- Automation API (see automation/Automation.kt). -->
        <receiver
            android:name=".automation.AutomationReceiver"
            android:exported="true"
            android:permission="com.dotforge.permission.AUTOMATE">
            <intent-filter>
                <action android:name="com.dotforge.action.PLAY_COMPOSITION" />
                <action android:name="com.dotforge.action.SHOW_GLYPH" />
                <action android:name="com.dotforge.action.VISUALISER" />
                <action android:name="com.dotforge.action.SET_RULE" />
            </intent-filter>
        </receiver>

        <!-- The same API for apps that can't hold the permission (Tasker's Send intent): obeyed only with the
             Integrations page's secret key in the "key" extra; "Let other apps show designs" switches it off. -->
        <receiver
            android:name=".automation.KeyReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.dotforge.action.PLAY_COMPOSITION" />
                <action android:name="com.dotforge.action.SHOW_GLYPH" />
                <action android:name="com.dotforge.action.VISUALISER" />
                <action android:name="com.dotforge.action.SET_RULE" />
            </intent-filter>
        </receiver>

        <!-- Tasker / Locale action plugin: the edit screen and the receiver that runs saved actions. Only settings
             signed by DotForge's own edit screen are run. -->
        <activity
            android:name=".automation.PluginEditActivity"
            android:exported="true"
            android:icon="@drawable/ic_app"
            android:label="@string/app_name"
            android:theme="@style/Theme.DotForge">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".automation.PluginFireReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings tile: glyph torch. -->
        <service
            android:name=".tile.TorchTileService"
            android:exported="true"
            android:icon="@drawable/ic_toy"
            android:label="@string/torch_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Timer & stopwatch: runs while one of DotForge's timers or the stopwatch is going. -->
        <service
            android:name=".timer.TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A countdown timer and stopwatch the user started, shown on the Glyph Matrix until it ends" />
        </service>
        <receiver
            android:name=".timer.TimerReceiver"
            android:exported="false" />
        <!-- "Time's up", full screen over the lock screen, until it is dismissed. -->
        <activity
            android:name=".timer.TimesUpActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <!-- Live music visualiser: runs while switched on, drives the matrix only while music plays. -->
        <service
            android:name=".visualiser.LiveVisualiserService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Quick Settings tile: Live music visualiser. -->
        <service
            android:name=".visualiser.LiveTileService"
            android:exported="true"
            android:icon="@drawable/toy_music"
            android:label="@string/live_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

